# Configuración del Chat Overlay Multistream

# Puerto del servidor
PORT=3000

# Canal de Twitch (sin el #)
TWITCH_CHANNEL=tu_canal

# ============================================
# TWITCH API (para badges)
# ============================================
# Obtén estas credenciales en: https://dev.twitch.tv/console/apps
# 1. Crea una nueva aplicación
# 2. Nombre: Chat Overlay (o el que prefieras)
# 3. URL de redirección: http://localhost:3000
# 4. Categoría: Chat Bot
# 5. Copia el Client ID y genera un Client Secret

TWITCH_CLIENT_ID=tu_client_id_aqui
TWITCH_CLIENT_SECRET=tu_client_secret_aqui

# Canal de Kick
KICK_CHANNEL=tu_canal

# Habilitar/deshabilitar Kick (true/false)
KICK_ENABLED=true

# Usar mock de Kick en lugar de Puppeteer (true/false)
# true = Mock simulado (desarrollo, ligero)
# false = Puppeteer real (producción, consume más recursos)
KICK_USE_MOCK=false
# ============================================
# YOUTUBE (InnerTube - sin API Key ni OAuth)
# ============================================
# No necesita credenciales de Google Cloud: usa youtube.js (InnerTube),
# la API privada de YouTube. Sin límites de cuota.

# Habilitar/deshabilitar YouTube (true/false)
YOUTUBE_ENABLED=true

# Canal del que autodetectar el directo.
# Acepta '@handle' o el ID del canal 'UCxxxxxxxxxxxxxxxxxxxxxx'.
# El servidor resuelve solo el ID del video cuando sales al aire.
# Requisito: el directo debe ser PÚBLICO (los no listados/privados no se detectan).
YOUTUBE_CHANNEL=@tu_canal

# Override manual OPCIONAL. Déjalo vacío para autodetectar por canal.
# Si lo rellenas, se salta la autodetección y conecta directamente a ese video.
# Es el código después de watch?v= en la URL.
# Ejemplo: para https://www.youtube.com/watch?v=dQw4w9WgXcQ -> dQw4w9WgXcQ
YOUTUBE_VIDEO_ID=